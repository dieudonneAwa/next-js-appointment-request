# Configure the booking form before accepting appointment requests.
# The blank secrets are intentional; supply them in your private .env or deployment settings.
# The email guide is in docs/email-setup.md; development log mode works without provider credentials.

APP_URL=http://localhost:3000 # Public origin of the appointment form, used to check incoming submissions.
HOST=127.0.0.1 # Next.js ignores HOST; use the --hostname option on npm start to change its bind address.
PORT=3000 # Set the production listener port here; the dev server has its own configuration.
DB_PATH=.data/app.sqlite # Requested times, appointment decisions, and outgoing messages; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Set a random 16+ character password to accept or decline appointments. Sign in as admin.
OWNER_EMAIL=owner@example.com # Not used for appointment decisions; this setting can be left empty.
REVIEWER_EMAIL=reviewer@example.com # Ignored by this workflow; appointment decisions do not use a configured reviewer.
MAIL_MODE=sandbox # For appointment decisions: sandbox for capture, production for real sending, log for local development.
MAIL_FROM=sender@example.com # Address sending appointment decisions; for production, choose one on your verified Mailtrap domain.
MAILTRAP_PRODUCTION_TOKEN= # Add your Mailtrap transactional token here to send appointment decisions in production.
MAILTRAP_SANDBOX_TOKEN= # For sandbox API calls, copy the token from your Mailtrap inbox integration settings.
MAILTRAP_INBOX_ID= # Inbox ID from Mailtrap Sandbox integration settings; captures appointment decisions during setup.
